# URL frontend yang boleh mengontrol bridge kamera. Pisahkan dengan koma.
# Untuk dashboard Vercel, pakai URL persis domain produksinya.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Fase 1: Canon + WinUSB dari Zadig + libgphoto2/gphoto2.
CAMERA_PROVIDER=gphoto2
GPHOTO2_PATH=C:\msys64\ucrt64\bin\gphoto2.exe
CAMERA_AGENT_LISTEN=127.0.0.1:8787
CAMERA_AGENT_CAPTURE_DIR=C:\Potobox\captures

# local menyimpan foto sementara di PC booth dan melayani /api/captures/*.
# Ubah ke supabase hanya jika upload langsung dari bridge benar-benar diperlukan.
CAMERA_AGENT_STORAGE=local

# Hanya wajib bila CAMERA_AGENT_STORAGE=supabase.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=potobox-galleries
